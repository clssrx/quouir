{
	"name": "quouir",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"predev": "npm run typegen",
		"prebuild": "npm run typegen",
		"typegen": "sanity schema extract --force --enforce-required-fields --path=./src/sanity/extract.json && sanity typegen generate",
		"test": "playwright test",
		"test:smoke": "playwright test tests/smoke.spec.ts",
		"test:a11y": "playwright test tests/a11y.spec.ts"
	},
	"dependencies": {
		"@sanity/image-url": "^2.1.1",
		"@sanity/vision": "^6.6.0",
		"next": "^16.2.12",
		"next-sanity": "^13.2.1",
		"react": "^19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "^5.5.0",
		"sanity": "^6.6.0",
		"styled-components": "^6.3.9"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@playwright/test": "^1.59.1",
		"@sanity/client": "^7.14.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24.13.3",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "^16.2.12",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"playwright": "^1.59.1",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
